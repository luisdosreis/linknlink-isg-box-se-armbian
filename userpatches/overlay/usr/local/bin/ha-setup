#!/usr/bin/env bash
set -euo pipefail

STACK_DIR=/opt/ha-stack
TEMPLATE_DIR=/usr/share/ha-stack/templates
STATE_DIR=/var/lib/ha-stack
DONE_FILE="${STATE_DIR}/setup.done"
DOCKER_KEY=/usr/share/keyrings/docker.gpg
DOCKER_SOURCE=/etc/apt/sources.list.d/docker.sources

usage() {
    cat <<'EOF'
usage: ha-setup [--force]

Install and start the Home Assistant Container stack after Armbian first-login
setup has completed.
EOF
}

die() {
    echo "ha-setup: $*" >&2
    exit 1
}

require_root() {
    [[ "${EUID}" -eq 0 ]] || die "run as root or with sudo"
}

first_login_complete() {
    [[ ! -e /root/.not_logged_in_yet ]]
}

wait_for_dns() {
    local attempt

    for attempt in {1..20}; do
        if getent hosts deb.debian.org >/dev/null 2>&1 && getent hosts download.docker.com >/dev/null 2>&1; then
            return 0
        fi
        echo "Waiting for DNS/network before installing packages (${attempt}/20)..."
        sleep 6
    done

    die "DNS/network is not ready; check network connectivity and run ha-setup again"
}

add_docker_repo() {
    local codename

    codename="$(. /etc/os-release && printf '%s' "${VERSION_CODENAME:-bookworm}")"
    install -d -m 0755 /etc/apt/keyrings /usr/share/keyrings /etc/apt/sources.list.d

    if [[ ! -f "$DOCKER_KEY" ]]; then
        curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o "$DOCKER_KEY"
        chmod 0644 "$DOCKER_KEY"
    fi

    cat >"$DOCKER_SOURCE" <<EOF
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: ${codename}
Components: stable
Architectures: arm64
Signed-By: /usr/share/keyrings/docker.gpg
EOF
}

install_packages() {
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        lsb-release

    add_docker_repo
    apt-get update
    apt-get install -y --no-install-recommends \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin \
        network-manager \
        avahi-daemon \
        dbus \
        bluez \
        udev \
        curl \
        jq \
        zram-tools \
        ca-certificates \
        gnupg \
        lsb-release
}

create_home_user_if_needed() {
    if getent passwd home >/dev/null 2>&1; then
        return 0
    fi

    if awk -F: '($3 >= 1000 && $3 < 60000 && $1 != "nobody") { found=1 } END { exit found ? 0 : 1 }' /etc/passwd; then
        return 0
    fi

    adduser --disabled-password --gecos "Home Assistant" home
    printf 'home:assistant\n' | chpasswd
    usermod -aG sudo,dialout,plugdev,bluetooth home 2>/dev/null || true
    echo "Created fallback user 'home' with default password 'assistant'. Change it immediately."
}

install_stack_files() {
    [[ -d "$TEMPLATE_DIR" ]] || die "template directory not found: $TEMPLATE_DIR"

    install -d -m 0755 \
        "$STACK_DIR" \
        "$STACK_DIR/homeassistant" \
        "$STACK_DIR/mosquitto/config" \
        "$STACK_DIR/mosquitto/data" \
        "$STACK_DIR/mosquitto/log" \
        "$STACK_DIR/zigbee2mqtt" \
        "$STACK_DIR/esphome" \
        "$STACK_DIR/matter" \
        "$STACK_DIR/zwave-js-ui" \
        "$STACK_DIR/backups" \
        /etc/docker \
        /etc/systemd/system

    cp -a "${TEMPLATE_DIR}/opt/ha-stack/." "$STACK_DIR/"
    cp -a "${TEMPLATE_DIR}/etc/systemd/system/ha-stack.service" /etc/systemd/system/ha-stack.service

    if [[ ! -f "$STACK_DIR/.env" ]]; then
        install -m 0644 "$STACK_DIR/.env.example" "$STACK_DIR/.env"
    fi
}

install_docker_daemon_config() {
    local source="${TEMPLATE_DIR}/etc/docker/daemon.json"
    local target=/etc/docker/daemon.json
    local tmp

    [[ -f "$source" ]] || die "Docker daemon template is missing: $source"

    if [[ -f "$target" ]]; then
        tmp="$(mktemp)"
        jq -s '.[0] * .[1]' "$target" "$source" >"$tmp"
        install -m 0644 "$tmp" "$target"
        rm -f "$tmp"
    else
        install -m 0644 "$source" "$target"
    fi
}

enable_services() {
    systemctl daemon-reload
    systemctl enable --now docker.service
    systemctl enable NetworkManager.service 2>/dev/null || true
    systemctl enable --now avahi-daemon.service
    systemctl enable --now bluetooth.service 2>/dev/null || systemctl enable --now bluetooth 2>/dev/null || true
    systemctl enable ha-stack.service
}

start_stack() {
    docker compose --project-directory "$STACK_DIR" pull homeassistant mosquitto
    systemctl restart ha-stack.service
}

main() {
    local force=no

    case "${1:-}" in
        --force)
            force=yes
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        "")
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac

    require_root
    first_login_complete || die "finish Armbian first-login setup before running ha-setup"

    if [[ "$force" != "yes" && -e "$DONE_FILE" ]]; then
        die "Home Assistant setup already completed; use --force to run again"
    fi

    wait_for_dns
    create_home_user_if_needed
    install_packages
    install_stack_files
    install_docker_daemon_config
    enable_services
    start_stack

    install -d -m 0755 "$STATE_DIR"
    date -u +%Y-%m-%dT%H:%M:%SZ >"$DONE_FILE"

    echo
    echo "Home Assistant Container is starting."
    echo "Open: http://<device-ip>:8123"
    echo "Check status with: ha-app status"
}

main "$@"
