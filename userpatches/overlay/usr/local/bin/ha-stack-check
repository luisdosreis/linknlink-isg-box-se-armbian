#!/usr/bin/env bash
set -euo pipefail

failures=0

check() {
    local name="$1"
    shift

    if "$@" >/dev/null 2>&1; then
        printf '[ OK ] %s\n' "$name"
    else
        printf '[FAIL] %s\n' "$name"
        failures=$((failures + 1))
    fi
}

note() {
    printf '[NOTE] %s\n' "$1"
}

check "docker is installed" command -v docker
check "docker compose works" docker compose version
check "/opt/ha-stack/compose.yaml exists" test -f /opt/ha-stack/compose.yaml
check "ha-stack.service exists" test -f /etc/systemd/system/ha-stack.service
check "avahi-daemon is active" systemctl is-active --quiet avahi-daemon.service
check "dbus is active" systemctl is-active --quiet dbus.service
check "/run/dbus exists" test -d /run/dbus

if [[ -d /dev/serial/by-id ]]; then
    printf '[ OK ] /dev/serial/by-id exists\n'
else
    note "/dev/serial/by-id does not exist yet; plug in a USB radio and check again"
fi

check "IPv6 is enabled" test -f /proc/net/if_inet6
check "cgroups are available" test -d /sys/fs/cgroup
check "overlayfs is available" grep -qw overlay /proc/filesystems

if ((failures > 0)); then
    exit 1
fi
