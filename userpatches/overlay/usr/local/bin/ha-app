#!/usr/bin/env bash
set -euo pipefail

STACK_DIR=/opt/ha-stack
SEEKWAVE_POWER_CONFIG=/etc/modprobe.d/seekwave-power.conf
SEEKWAVE_POWER_PARAM=/sys/module/skw_sdio_lite/parameters/fw_deepsleep

usage() {
    cat <<'EOF'
usage: ha-app <command> [argument]

Commands:
  enable homeassistant|mqtt|zigbee|esphome|matter|zwave|all
  disable homeassistant|mqtt|zigbee|esphome|matter|zwave|all
  restart homeassistant|mqtt|zigbee|esphome|matter|zwave|all
  update
  backup [--safe|--live]
  logs [service]
  status
  wifi-power status|performance|powersave

State-changing stack commands require root. backup defaults to --safe, which
briefly stops running containers before creating the archive.
EOF
}

die() {
    echo "ha-app: $*" >&2
    exit 1
}

require_stack() {
    [[ -d "$STACK_DIR" ]] || die "$STACK_DIR does not exist"
    [[ -f "$STACK_DIR/compose.yaml" ]] || die "$STACK_DIR/compose.yaml does not exist"
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker compose version >/dev/null 2>&1 || die "docker compose plugin is not available"
}

compose() {
    docker compose --project-directory "$STACK_DIR" "$@"
}

compose_with_profiles() {
    compose --profile zigbee --profile esphome --profile matter --profile zwave "$@"
}

require_root() {
    ((EUID == 0)) || die "run this command as root"
}

wifi_power_status() {
    local value mode persistent_value persistent_mode

    [[ -r "$SEEKWAVE_POWER_PARAM" ]] || die "SeekWave fw_deepsleep control is unavailable; boot an image with the updated driver"
    value="$(<"$SEEKWAVE_POWER_PARAM")"
    case "$value" in
        0|N|n|false|False)
            mode=performance
            ;;
        1|Y|y|true|True)
            mode=powersave
            ;;
        *)
            mode=unknown
            ;;
    esac

    printf 'Wi-Fi power mode: %s (firmware deep sleep: %s)\n' "$mode" "$value"
    if [[ -r "$SEEKWAVE_POWER_CONFIG" ]]; then
        persistent_value="$(sed -n 's/^options skw_sdio_lite fw_deepsleep=//p' "$SEEKWAVE_POWER_CONFIG" | tail -n 1)"
        case "$persistent_value" in
            0)
                persistent_mode=performance
                ;;
            1)
                persistent_mode=powersave
                ;;
            *)
                persistent_mode=invalid
                ;;
        esac
        printf 'Persistent policy: %s (firmware deep sleep: %s)\n' "$persistent_mode" "${persistent_value:-unset}"
    else
        echo 'Persistent policy: not configured'
    fi
}

set_wifi_power_mode() {
    local mode="${1:-}" value old_value tmp

    case "$mode" in
        performance)
            value=0
            ;;
        powersave)
            value=1
            ;;
        *)
            die "wifi-power expects performance or powersave"
            ;;
    esac

    require_root
    [[ -w "$SEEKWAVE_POWER_PARAM" ]] || die "SeekWave fw_deepsleep control is unavailable; boot an image with the updated driver"

    old_value="$(<"$SEEKWAVE_POWER_PARAM")"
    case "$old_value" in
        0|N|n|false|False)
            old_value=0
            ;;
        1|Y|y|true|True)
            old_value=1
            ;;
        *)
            die "current SeekWave fw_deepsleep value is invalid: $old_value"
            ;;
    esac

    install -d -m 0755 /etc/modprobe.d
    tmp="$(mktemp /etc/modprobe.d/.seekwave-power.conf.XXXXXX)"
    printf 'options skw_sdio_lite fw_deepsleep=%s\n' "$value" >"$tmp"
    chmod 0644 "$tmp"

    if ! printf '%s\n' "$value" >"$SEEKWAVE_POWER_PARAM"; then
        rm -f "$tmp"
        die "could not apply Wi-Fi power mode; persistent policy was unchanged"
    fi

    if ! mv -f "$tmp" "$SEEKWAVE_POWER_CONFIG"; then
        rm -f "$tmp"
        if printf '%s\n' "$old_value" >"$SEEKWAVE_POWER_PARAM"; then
            die "could not persist Wi-Fi power mode; restored the previous live mode"
        fi
        die "could not persist Wi-Fi power mode or restore the previous live mode"
    fi

    wifi_power_status
}

enable_service() {
    local service="${1:-}"

    case "$service" in
        homeassistant)
            compose up -d homeassistant
            ;;
        mqtt)
            compose up -d mosquitto
            ;;
        zigbee)
            compose --profile zigbee up -d
            ;;
        esphome)
            compose --profile esphome up -d
            ;;
        matter)
            compose --profile matter up -d
            ;;
        zwave)
            compose --profile zwave up -d
            ;;
        all)
            compose --profile zigbee --profile esphome --profile matter --profile zwave up -d
            ;;
        "")
            die "missing service for enable"
            ;;
        *)
            die "unknown service for enable: $service"
            ;;
    esac
}

disable_service() {
    local service="${1:-}"
    local running_services=()

    case "$service" in
        homeassistant)
            compose stop homeassistant
            ;;
        mqtt)
            compose stop mosquitto
            ;;
        zigbee)
            compose_with_profiles stop zigbee2mqtt
            ;;
        esphome|matter)
            compose_with_profiles stop "$service"
            ;;
        zwave)
            compose_with_profiles stop zwave-js-ui
            ;;
        all)
            mapfile -t running_services < <(compose_with_profiles ps --services --status running)
            ((${#running_services[@]} > 0)) || return 0
            compose_with_profiles stop "${running_services[@]}"
            ;;
        "")
            die "missing service for disable"
            ;;
        *)
            die "unknown service for disable: $service"
            ;;
    esac
}

restart_service() {
    local service="${1:-}"
    local running_services=()

    case "$service" in
        homeassistant)
            compose restart homeassistant
            ;;
        mqtt)
            compose restart mosquitto
            ;;
        zigbee)
            compose_with_profiles restart zigbee2mqtt
            ;;
        esphome|matter)
            compose_with_profiles restart "$service"
            ;;
        zwave)
            compose_with_profiles restart zwave-js-ui
            ;;
        all)
            mapfile -t running_services < <(compose_with_profiles ps --services --status running)
            ((${#running_services[@]} > 0)) || return 0
            compose_with_profiles restart "${running_services[@]}"
            ;;
        "")
            die "missing service for restart"
            ;;
        *)
            die "unknown service for restart: $service"
            ;;
    esac
}

backup_stack() {
    local mode="${1:---safe}" archive archive_tmp stamp
    local running_services=()

    case "$mode" in
        --safe|--live)
            ;;
        *)
            die "backup expects --safe or --live"
            ;;
    esac

    install -d -m 0755 "$STACK_DIR/backups"
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    archive="$STACK_DIR/backups/ha-stack-${stamp}.tar.gz"
    archive_tmp="$(mktemp "$STACK_DIR/backups/.ha-stack-${stamp}.tar.gz.XXXXXX")"

    if [[ "$mode" == "--safe" ]]; then
        mapfile -t running_services < <(compose_with_profiles ps --services --status running)
        if ((${#running_services[@]} > 0)); then
            if ! compose_with_profiles stop "${running_services[@]}"; then
                compose_with_profiles up -d "${running_services[@]}" || true
                die "could not stop stack services for a safe backup"
            fi
        fi
    fi

    if ! tar \
        --exclude='./backups' \
        --exclude='./mosquitto/log/*.log' \
        -C "$STACK_DIR" \
        -czf "$archive_tmp" .; then
        rm -f "$archive_tmp"
        if ((${#running_services[@]} > 0)); then
            compose_with_profiles up -d "${running_services[@]}" || true
        fi
        die "backup failed"
    fi

    if ! mv -f "$archive_tmp" "$archive"; then
        rm -f "$archive_tmp"
        if ((${#running_services[@]} > 0)); then
            compose_with_profiles up -d "${running_services[@]}" || true
        fi
        die "could not finalize backup archive"
    fi
    if ((${#running_services[@]} > 0)); then
        if ! compose_with_profiles up -d "${running_services[@]}"; then
            die "backup was created at $archive, but the previously running services could not be restarted"
        fi
    fi

    printf '%s\n' "$archive"
    sha256sum "$archive"
    du -h "$archive"
}

update_stack() {
    local running_services=()

    compose_with_profiles config -q
    mapfile -t running_services < <(compose_with_profiles ps --services --status running)

    ((${#running_services[@]} > 0)) || die "no stack services are running; use ha-app enable to start one"

    compose_with_profiles pull "${running_services[@]}"
    compose_with_profiles up -d "${running_services[@]}"
    docker image prune -f
}

main() {
    local command="${1:-}"

    case "$command" in
        enable)
            require_stack
            require_root
            enable_service "${2:-}"
            ;;
        disable)
            require_stack
            require_root
            disable_service "${2:-}"
            ;;
        restart)
            require_stack
            require_root
            restart_service "${2:-}"
            ;;
        update)
            require_stack
            require_root
            update_stack
            ;;
        backup)
            require_stack
            require_root
            backup_stack "${2:---safe}"
            ;;
        logs)
            require_stack
            compose logs -f "${2:-homeassistant}"
            ;;
        status)
            require_stack
            compose ps
            ;;
        wifi-power)
            case "${2:-status}" in
                status)
                    wifi_power_status
                    ;;
                performance|powersave)
                    set_wifi_power_mode "$2"
                    ;;
                *)
                    die "wifi-power expects status, performance, or powersave"
                    ;;
            esac
            ;;
        help|--help|-h)
            usage
            ;;
        "")
            usage
            exit 1
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
